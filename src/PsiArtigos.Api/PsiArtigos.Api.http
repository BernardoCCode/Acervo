@host = https://localhost:7xxx
@userId = 11111111-1111-1111-1111-111111111111

### Search articles
POST {{host}}/api/search
Content-Type: application/json
X-User-Id: {{userId}}

{
  "query": "machine learning",
  "filters": {
    "yearMin": 2020,
    "minCitations": 0
  }
}

### Search history
GET {{host}}/api/search/history?take=10
X-User-Id: {{userId}}

### Get article
GET {{host}}/api/articles/00000000-0000-0000-0000-000000000000
X-User-Id: {{userId}}

### Create learning trail
POST {{host}}/api/learning-trails
Content-Type: application/json
X-User-Id: {{userId}}

{
  "prompt": "Quero aprender visão computacional do zero"
}

### Reader preferences
GET {{host}}/api/reading/preferences
X-User-Id: {{userId}}
